{
    "name" : "书遥贝贝",
    "appid" : "",
    "description" : "记录宝宝的喂养、睡眠、尿布、疫苗与成长瞬间，支持家庭成员共同记录与查看",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    /* 5+App特有相关 */
    "app-plus" : {
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : true,
            "autoclose" : true,
            "delay" : 0
        },
        /* 模块配置 */
        "modules" : {},
        /* 应用发布信息 */
        "distribute" : {
            /* android打包配置 */
            "android" : {
                "permissions" : [
                    "<uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.MOUNT_UNMOUNT_FILESYSTEMS\"/>",
                    "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
                    "<uses-permission android:name=\"android.permission.READ_LOGS\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
                    "<uses-feature android:name=\"android.hardware.camera.autofocus\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CAMERA\"/>",
                    "<uses-permission android:name=\"android.permission.GET_ACCOUNTS\"/>",
                    "<uses-permission android:name=\"android.permission.READ_PHONE_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CHANGE_WIFI_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.WAKE_LOCK\"/>",
                    "<uses-permission android:name=\"android.permission.FLASHLIGHT\"/>",
                    "<uses-feature android:name=\"android.hardware.camera\"/>",
                    "<uses-permission android:name=\"android.permission.WRITE_SETTINGS\"/>"
                ]
            },
            /* ios打包配置 */
            "ios" : {},
            /* SDK配置 */
            "sdkConfigs" : {}
        }
    },
    /* 快应用特有相关 */
    "quickapp" : {},
    /* 小程序特有相关 */
    "mp-weixin" : {
        "appid" : "wx1b8ee065d7975ac7",
        /* 云开发云函数目录：编译时会拷进小程序产物，供微信开发者工具上传 */
        "cloudfunctionRoot" : "./cloudfunctions/",
        /* 组件按需注入：只把页面真正用到的组件打进包，能明显压小主包
           （代码质量面板的「启用组件按需注入」就是查这一项，会写入产物的 app.json） */
        "lazyCodeLoading" : "requiredComponents",
        /* 声明需要后台播放音频：安睡音用 wx.getBackgroundAudioManager 实现「息屏也能放」。
           不声明的话，退到后台时微信会提示「需在 app.json 中配置 requiredBackgroundModes」。
           ⚠️ 另外要去小程序后台「开发 → 开发管理 → 接口设置」确认有没有「音频播放后台运行」这一项，
              有就打开；找不到说明当前策略不需要单独申请。后台播放只有真机能验证。 */
        "requiredBackgroundModes" : [ "audio" ],
        /* 这些会原样写进产物里的 project.config.json，即微信开发者工具的那个「本地设置」。
           minified / minifyWXSS / minifyWXML 对应代码质量面板的「代码压缩」三项：
           不写的话 uni-app 生成的默认值是 false，面板就会判「JS文件未压缩」。 */
        "setting" : {
            "urlCheck" : false,
            "es6" : true,
            "postcss" : true,
            "minified" : true,
            "minifyWXSS" : true,
            "minifyWXML" : true,
            "enhance" : true,
            /* 上传时不附 sourcemap：map 文件会一起算进代码包体积（vendor 的 map 就有几百 KB），
               很容易把主包顶过 1.5 M。代价是小程序后台「错误日志」里的堆栈是压缩后的，
               要还原就本地用开发者工具复现（我们自己的报错都写进了 app_logs）。 */
            "uploadWithSourceMap" : false
        },
        "usingComponents" : true,
        /* 启用微信隐私相关功能：调用 chooseMedia / saveImageToPhotosAlbum /
           setClipboardData 等隐私接口前需用户同意《小程序用户隐私保护指引》，
           具体授权流程见 src/utils/privacy.js */
        "__usePrivacyCheck__" : true
        /* 语音输入（微信同声传译插件）暂未启用。
           开关在「设置 → 第三方服务 → 插件管理 → 添加插件」，**用 AppID wx069ba97219f66d99 搜**
           （中文名不一定搜得到）。加好插件后，在这里补上：
             "plugins" : { "WechatSI" : { "version" : "0.3.6", "provider" : "wx069ba97219f66d99" } }
           代码侧已就绪（src/pkg/utils/voice.js + src/pkg/ai-quick-record），
           插件没启用时「按住说话」按钮会自动隐藏，页面提示用键盘麦克风，不会白屏。 */
    },
    "mp-alipay" : {
        "usingComponents" : true
    },
    "mp-baidu" : {
        "usingComponents" : true
    },
    "mp-toutiao" : {
        "usingComponents" : true
    },
    "uniStatistics": {  
        "enable": false
    },
    "vueVersion" : "3"
}
