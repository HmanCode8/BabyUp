	/* 进这几个 tab 页时顺便把分包下好：分包本来就是按需下载，
	   不预下载的话「第一次点开某个二级页」会多一次下载等待。 */
	"preloadRule": {
		"pages/record/record": {
			"network": "all",
			"packages": ["pkg"]
		},
		"pages/index/index": {
			"network": "all",
			"packages": ["pkg"]
		},
		"pages/tools/tools": {
			"network": "all",
			"packages": ["pkg"]
		},
		"pages/profile/profile": {
			"network": "all",
			"packages": ["pkg"]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "书遥贝贝",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#F6F7F9"
	},
	"tabBar": {
		"color": "#9AA0A6",
		"selectedColor": "#FF8F6B",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/record/record",
				"text": "记录",
				"iconPath": "static/tabbar/record.png",
				"selectedIconPath": "static/tabbar/record-active.png"
			},
			{
				"pagePath": "pages/index/index",
				"text": "时光",
				"iconPath": "static/tabbar/time.png",
				"selectedIconPath": "static/tabbar/time-active.png"
			},
			{
				"pagePath": "pages/tools/tools",
				"text": "工具",
				"iconPath": "static/tabbar/tools.png",
				"selectedIconPath": "static/tabbar/tools-active.png"
			},
			{
				"pagePath": "pages/profile/profile",
				"text": "我的",
				"iconPath": "static/tabbar/mine.png",
				"selectedIconPath": "static/tabbar/mine-active.png"
			}
		]
	}
}
