{
	/* 主包只放「启动就要用」的页面：4 个 tab 页 + 登录/引导/隐私协议。
	   其余 27 个二级页全在下面 subPackages 的 pkg 分包里 —— 主包体积是微信的硬指标
	   （代码质量面板要求 < 1.5M），二级页按需加载，且下面 preloadRule 会在进 tab 时
	   就把分包预下载好，所以实际使用上感觉不到差别。
	   ⚠️ 注意：分包页面的路径是 /pkg/<name>/<name>，不要再写回 /pages/<name>/<name>。 */
	"pages": [
		{
			"path": "pages/record/record",
			"style": {
				"navigationBarTitleText": "记录",
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "时光",
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark",
				"onReachBottomDistance": 80
			}
		},
		{
			"path": "pages/tools/tools",
			"style": {
				"navigationBarTitleText": "育儿工具"
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/setup/setup",
			"style": {
				"navigationBarTitleText": "开始使用"
			}
		},
		{
			"path": "pages/join-family/join-family",
			"style": {
				"navigationBarTitleText": "加入家庭"
			}
		},
		{
			"path": "pages/privacy/privacy",
			"style": {
				"navigationBarTitleText": "隐私政策"
			}
		},
		{
			"path": "pages/terms/terms",
			"style": {
				"navigationBarTitleText": "用户协议"
			}
		}
	],
	"subPackages": [
		{
			"root": "pkg",
			"pages": [
				{
					"path": "forgot-password/forgot-password",
					"style": {
						"navigationBarTitleText": "找回密码"
					}
				},
				{
					"path": "account/account",
					"style": {
						"navigationBarTitleText": "账号与安全"
					}
				},
				{
					"path": "baby-edit/baby-edit",
					"style": {
						"navigationBarTitleText": "宝宝档案"
					}
				},
				{
					"path": "photo-detail/photo-detail",
					"style": {
						"navigationBarTitleText": "照片详情"
					}
				},
				{
					"path": "growth/growth",
					"style": {
						"navigationBarTitleText": "生长记录"
					}
				},
				{
					"path": "vaccine/vaccine",
					"style": {
						"navigationBarTitleText": "疫苗记录"
					}
				},
				{
					"path": "family/family",
					"style": {
						"navigationBarTitleText": "家庭成员"
					}
				},
				{
					"path": "feeding-edit/feeding-edit",
					"style": {
						"navigationBarTitleText": "喂养记录"
					}
				},
				{
					"path": "feeding-reminder/feeding-reminder",
					"style": {
						"navigationBarTitleText": "喂奶参考与提醒"
					}
				},
				{
					"path": "membership/membership",
					"style": {
						"navigationBarTitleText": "会员"
					}
				},
				{
					"path": "sleep-edit/sleep-edit",
					"style": {
						"navigationBarTitleText": "睡眠记录"
					}
				},
				{
					"path": "diaper-edit/diaper-edit",
					"style": {
						"navigationBarTitleText": "便便记录"
					}
				},
				{
					"path": "milestone/milestone",
					"style": {
						"navigationBarTitleText": "成长里程碑"
					}
				},
				{
					"path": "milestone-edit/milestone-edit",
					"style": {
						"navigationBarTitleText": "里程碑打卡"
					}
				},
				{
					"path": "illness/illness",
					"style": {
						"navigationBarTitleText": "生病记录"
					}
				},
				{
					"path": "illness-edit/illness-edit",
					"style": {
						"navigationBarTitleText": "记录生病"
					}
				},
				{
					"path": "checkup/checkup",
					"style": {
						"navigationBarTitleText": "儿保体检"
					}
				},
				{
					"path": "checkup-edit/checkup-edit",
					"style": {
						"navigationBarTitleText": "记录体检"
					}
				},
				{
					"path": "report/report",
					"style": {
