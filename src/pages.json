					}
				},
				{
					"path": "onboarding/onboarding",
					"style": {
						"navigationBarTitleText": "新手引导"
					}
				},
				{
					"path": "admin/admin",
					"style": {
						"navigationBarTitleText": "运维后台"
					}
				},
				{
					"path": "ai-chat/ai-chat",
					"style": {
						"navigationBarTitleText": "AI 照护助手"
					}
				},
				{
					"path": "ai-quick-record/ai-quick-record",
					"style": {
						"navigationBarTitleText": "一句话记一笔"
					}
				},
				{
					"path": "solid-food/solid-food",
					"style": {
